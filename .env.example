DB_PATH=./analytics.dev.db
CHANNEL_BOT_TOKEN=
CHANNEL_BOT_USERNAME=
PRIV_BOT_TOKEN=
PORT=3000
API_SECRET=
ADMIN_TG_IDS=
# Public base URL of the dashboard. Must be a STABLE domain and must exactly
# match the one registered for the bot via BotFather /setdomain, otherwise the
# Telegram Login Widget on the login page will not render.
DASHBOARD_URL=http://localhost:3000
# Optional: local HTTP proxy for Telegram API connectivity (machine-specific, leave blank normally)
TELEGRAM_PROXY_URL=
# Optional: where daily sqlite backups are written and how many to keep (defaults shown)
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=14
TRASH_RETENTION_DAYS=30

# --- Проверка рекламных постов (раздел «Реклама») ---
# Своя сессия аккаунта Telegram: читает посты в чужих и своих каналах.
# api_id и api_hash — my.telegram.org → API development tools. Вход один раз:
#   npm run tg:login        (в Docker: docker compose run --rm analytics npm run tg:login)
# Без них проверка выключена, остальное работает как раньше.
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=./tg-session/account.session
# Ключ для posting (отдельный сервер): пускает только к POST /api/ads/posts —
# отчётам о постах «Реклама». Не API_SECRET: тот открывает всё API, включая
# выгрузку базы. Сгенерировать: openssl rand -hex 32
ADS_REPORT_KEY=
# Бот отслежки для админов, у которых куплена реклама (@BotFather → новый бот).
# Админ открывает ссылку из карточки закупа и видит, сколько пришло, ушло и
# осталось по вашей ссылке; карточка обновляется сама, в конце приходит итог.
# Пусто — отслежки нет.
TRACK_BOT_TOKEN=
# Часовой пояс, в котором записаны места (утро, 19:00 и т. д.)
ADS_TIMEZONE=Europe/Moscow
